# Docker reaches the two host services through this container-safe hostname.
# Change these only when either engine is published somewhere else.
MOTIF_FEEDBACK_URL=http://host.docker.internal:8000
MOTIF_FOLDING_URL=http://host.docker.internal:8001

# Cycles service and bridge request defaults.
MOTIF_CYCLES_PORT=8002
MOTIF_CYCLES_TIMEOUT_SECONDS=600

# Direct host execution already defaults to the following values. Export them
# in your shell only when you want to override those defaults; Docker supplies
# its own container-safe bind address and workspace path.
# MOTIF_CYCLES_HOST=127.0.0.1
# MOTIF_CYCLES_WORKSPACE=./workspace
